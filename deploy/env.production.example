# Paste into Laravel Cloud → Environment → Environment variables.
# Do not set DB_HOST, DB_DATABASE, DB_USERNAME, DB_PASSWORD, or FILESYSTEM_DISK.
# Cloud injects those when you attach MySQL and an object-storage bucket.
# A variable you set yourself overrides the injected one.

APP_NAME=SOMA
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-app.laravel.cloud

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

LOG_CHANNEL=stack
LOG_LEVEL=error

# Cloud fills the host, database, user, and password after you attach MySQL.
DB_CONNECTION=mysql

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=SOMA
